{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Narration Stream Event",
  "description": "One NDJSON line of GET /classes/{classId}/narration/{order} (V0-013). Audio is per semantic chunk; markers are semantic (DEC-RUNTIME-006); a client discards any event whose actor_epoch/generation is not the current one (DEC-RUNTIME-007).",
  "type": "object",
  "required": ["schema_version", "type", "sequence", "class_id", "session_id", "scene_id", "actor_epoch", "state_version", "generation"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "type": {"enum": ["narration.started", "segment.started", "caption", "audio", "marker", "segment.completed", "segment.fallback", "narration.completed", "narration.cancelled", "error"]},
    "sequence": {"type": "integer", "minimum": 1},
    "class_id": {"type": "string"},
    "session_id": {"type": "string"},
    "scene_id": {"type": "string"},
    "actor_epoch": {"type": "integer", "minimum": 1},
    "state_version": {"type": "integer", "minimum": 0},
    "generation": {"type": "integer", "minimum": 1},
    "chunk_index": {"type": "integer", "minimum": 0},
    "chunk_count": {"type": "integer", "minimum": 0},
    "source": {"enum": ["lesson-script", "fallback-script", "speaker-notes", "slide-text", "none"]},
    "provider": {"type": "object"},
    "text": {"type": "string"},
    "marker_ids": {"type": "array", "items": {"type": "string"}},
    "marker_id": {"type": "string"},
    "offset_ms": {"type": "integer", "minimum": 0},
    "content_type": {"type": "string"},
    "data": {"type": "string", "contentEncoding": "base64"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "status": {"enum": ["COMPLETED", "FALLBACK", "EMPTY", "CANCELLED"]},
    "reason": {"type": "string"},
    "checkpoint": {"type": "object"},
    "code": {"type": "string"},
    "message": {"type": "string"}
  }
}
