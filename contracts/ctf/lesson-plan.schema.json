{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lesson Plan",
  "type": "object",
  "required": [
    "lesson_plan_version",
    "lesson_id",
    "sections"
  ],
  "properties": {
    "lesson_plan_version": {
      "type": "string"
    },
    "lesson_id": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "section_id",
          "type",
          "safe_markers"
        ],
        "properties": {
          "section_id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "EXPLANATION",
              "EXAMPLE",
              "MEDIA",
              "QUIZ",
              "DISCUSSION"
            ]
          },
          "concept_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "scene_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "scene_step_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "script": {
            "type": [
              "string",
              "null"
            ]
          },
          "safe_markers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fallback_script": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
