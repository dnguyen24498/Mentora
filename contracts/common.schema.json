{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mentora Common",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1
    },
    "stateVersion": {
      "type": "integer",
      "minimum": 0
    }
  }
}
